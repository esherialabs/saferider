{
  "schema": "schemas/dependency-policy.schema.json",
  "schemaVersion": 1,
  "policyId": "saferide-dependency-policy-v1",
  "lockfiles": [
    { "workspace": "mobile", "path": "package-lock.json" },
    { "workspace": "api", "path": "apps/api/package-lock.json" },
    { "workspace": "web", "path": "web/package-lock.json" }
  ],
  "allowedRegistryOrigins": ["https://registry.npmjs.org"],
  "forbiddenDependencyProtocols": ["file:", "git:", "git+", "http:", "link:"],
  "ciAuditLevel": "high",
  "releaseAuditMaximum": "none",
  "releaseAuditMaxAgeHours": 24,
  "unknownLicenseInventory": [
    { "workspace": "mobile", "packagePath": "node_modules/xmlhttprequest-ssl", "name": "xmlhttprequest-ssl", "version": "2.1.2" }
  ],
  "unknownLicensesRequireLegalReview": true
}
