  "schemaVersion": 1,
  "policyId": "saferide-safe-assistant-v0.4",
  "version": "0.4.0-candidate.1",
  "status": "approved",
  "effectiveDate": "2026-08-02",
  "scope": "on-device synthetic guidance candidate",
  "languages": {
    "en": {
      "evaluationEnabled": true,
      "productEnabled": false,
