{
  "expo": {
    "name": "Safe Ride",
    "slug": "saferide",
    "scheme": "saferide",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/df299186-b444-414a-bae3-1e2c263c6927"
    },
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.esheria.saferide.app",
      "versionCode": 2,
      "icon": "./assets/adaptive-icon.png",
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFF8F3"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.esheria.saferide.app",
      "icon": "./assets/adaptive-icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "SafeRide uses the camera only when you choose to capture photo or video evidence for a draft.",
        "NSMicrophoneUsageDescription": "SafeRide uses the microphone only when you choose to record audio evidence or enable a supported stealth audio trigger.",
        "NSLocationWhenInUseUsageDescription": "SafeRide uses location only when you choose to add current location to a report draft.",
        "NSPhotoLibraryUsageDescription": "SafeRide accesses your photo library only when you choose media evidence to add to a draft."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSafeRideLiteRtLm",
      "expo-secure-store",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Inter.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/Inter.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Inter.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Inter.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SafeRide uses the microphone only when you choose to record audio evidence or enable a supported stealth audio trigger.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#793A5E",
          "android": {
            "drawable": {
              "icon": "./assets/splashscreen-blank.xml"
            },
            "backgroundColor": "#793A5E"
          },
          "ios": {
            "backgroundColor": "#793A5E"
          }
        }
      ],
      "expo-asset"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "df299186-b444-414a-bae3-1e2c263c6927"
      }
    },
    "owner": "vince-esherias-organization"
  }
}
