{
  "name": "@saferide/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ws": "tsx watch src/websocket/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:ws": "node dist/websocket/server.js",
    "evidence:rsi:synthetic": "tsx src/jobs/generateRsiSyntheticProof.ts",
    "retention:rsi": "node dist/jobs/rsiRetentionJob.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:env-examples": "node scripts/validate-env-examples.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "fastify": "^5.11.0",
    "ioredis": "^5.6.1",
    "jose": "^5.10.0",
    "minio": "^8.0.5",
    "pg": "^8.15.6",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.4",
    "typescript": "~6.0.3"
  }
}
