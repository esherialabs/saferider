# SafeRide local environment template.
# Copy to .env.local for Expo Go and local mobile development.

# Public Expo runtime config. These values are bundled into the client.
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:3333/api
EXPO_PUBLIC_API_TIMEOUT_MS=10000
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:3334
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:3333/auth
EXPO_PUBLIC_STORAGE_BASE_URL=http://localhost:9000/evidence
EXPO_PUBLIC_RUNTIME_CONFIG_URL=http://localhost:3333/api/config/runtime
EXPO_PUBLIC_CONFIG_REFRESH_SECONDS=60
EXPO_PUBLIC_OPENAI_ENABLED=true

# Leave blank for local development. EAS preview/production must set exact public host allowlists.
EXPO_PUBLIC_RELEASE_ENDPOINT_HOSTS=
EXPO_PUBLIC_RELEASE_STORAGE_HOSTS=

# For Expo Go on a physical phone, replace localhost above with your computer's LAN IP.
# EAS preview/production builds must not use localhost, LAN/private IP, http, ws, or Supabase endpoints.
# Preview and production also require EXPO_PUBLIC_RUNTIME_CONFIG_URL plus the release host allowlists above.

# On-device assistant config. No private model/provider keys go here.
EXPO_PUBLIC_LOCAL_ASSISTANT_ENABLED=true
EXPO_PUBLIC_LOCAL_ASSISTANT_PREFER_ON_DEVICE=true
EXPO_PUBLIC_MODERATED_TEST_MODE=false
EXPO_PUBLIC_MODERATED_TEST_CONTROL_VERSION=moderated-test-controls.2026-07-30.1
EXPO_PUBLIC_LOCAL_ASSISTANT_MODEL_ID=litert-community/gemma-4-E2B-it-litert-lm

# Direct Azure transcription from Expo is disabled because API keys are private.
# Use a backend proxy before enabling remote transcription again.
EXPO_PUBLIC_AZURE_OPENAI_TRANSCRIPTION_ENABLED=false
EXPO_PUBLIC_AZURE_OPENAI_ENDPOINT=
EXPO_PUBLIC_AZURE_OPENAI_DEPLOYMENT=
EXPO_PUBLIC_AZURE_OPENAI_API_VERSION=

# Private server/local-only secrets. Never expose these with EXPO_PUBLIC_*.
OPENAI_API_KEY=replace-with-local-openai-key
OPENAI_BASE_URL=replace-with-local-openai-base-url
OPENAI_API_VERSION=replace-with-local-openai-api-version
OPENAI_MODEL=replace-with-local-openai-model
HELICONE_AUTH_TOKEN=replace-with-local-helicone-token
HELICONE_OPENAI_API_BASE=replace-with-local-helicone-openai-api-base
AZURE_OPENAI_ENDPOINT=replace-with-local-azure-openai-endpoint
AZURE_OPENAI_API_KEY=replace-with-local-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=replace-with-local-azure-openai-deployment
AZURE_OPENAI_API_VERSION=replace-with-local-azure-openai-api-version
