{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/external-handoff.schema.json",
  "title": "SafeRide executable external dependency handoffs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "registerId", "asOfDate", "handoffs"],
  "properties": {
    "schema": { "const": "com.saferide.external-handoff-register" },
    "schemaVersion": { "const": 1 },
    "registerId": { "$ref": "#/$defs/nonEmpty" },
    "asOfDate": { "$ref": "#/$defs/date" },
    "handoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handoffId",
          "dependencyType",
          "capability",
          "status",
          "ownerRole",
          "requiredInputs",
          "procedure",
          "expectedArtifacts",
          "passGate",
          "failClosedEffects",
          "affectedClaimIds",
          "lastVerifiedDate",
          "recheckDate"
        ],
        "properties": {
          "handoffId": { "$ref": "#/$defs/nonEmpty" },
          "dependencyType": { "enum": ["colab", "device", "human-review", "legal", "privacy", "safeguarding", "language", "partner", "unicef", "ci-account", "release-authority"] },
          "capability": { "$ref": "#/$defs/nonEmpty" },
          "status": { "enum": ["blocked", "ready-for-owner", "in-execution", "passed", "expired", "superseded"] },
          "resolution": { "$ref": "#/$defs/nonEmpty" },
          "ownerRole": { "$ref": "#/$defs/nonEmpty" },
          "requiredInputs": { "$ref": "#/$defs/nonEmptyArray" },
          "procedure": { "$ref": "#/$defs/nonEmptyArray" },
          "expectedArtifacts": { "$ref": "#/$defs/nonEmptyArray" },
          "passGate": { "$ref": "#/$defs/nonEmptyArray" },
          "failClosedEffects": { "$ref": "#/$defs/nonEmptyArray" },
          "affectedClaimIds": { "$ref": "#/$defs/nonEmptyArray" },
          "lastVerifiedDate": { "$ref": "#/$defs/date" },
          "recheckDate": { "$ref": "#/$defs/date" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] },
            "then": { "required": ["resolution"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
