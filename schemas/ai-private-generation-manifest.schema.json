{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-private-generation-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "runMode", "manifestId", "evaluationRunId", "createdAt", "artifact", "promptSuite", "rubric", "policy", "systemPrompt", "generationConfig", "runtime", "privateBundle", "rows", "privacy"],
  "properties": {
    "schema": { "const": "com.saferide.ai.private-generation-manifest" },
    "schemaVersion": { "const": 1 },
    "runMode": { "enum": ["full", "smoke"] },
    "manifestId": { "$ref": "#/$defs/nonEmpty" },
    "evaluationRunId": { "$ref": "#/$defs/nonEmpty" },
    "createdAt": { "$ref": "#/$defs/nonEmpty" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "promptSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "requiredPromptCount", "selectedPromptCount", "promptInventorySha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "requiredPromptCount": { "type": "integer", "minimum": 1 },
        "selectedPromptCount": { "type": "integer", "minimum": 1 },
        "promptInventorySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rubric": { "$ref": "#/$defs/fileRef" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "version", "sha256"],
      "properties": {
        "policyId": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "systemPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptId", "configPath", "configSha256", "textSha256"],
      "properties": {
        "promptId": { "$ref": "#/$defs/nonEmpty" },
        "configPath": { "$ref": "#/$defs/nonEmpty" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "textSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generationConfig": { "$ref": "#/$defs/generationConfig" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "pythonVersion", "packages", "accelerator"],
      "properties": {
        "engine": { "const": "transformers-peft" },
        "pythonVersion": { "$ref": "#/$defs/nonEmpty" },
        "packages": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmpty" }
        },
        "accelerator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cudaAvailable", "deviceCount", "deviceClass"],
          "properties": {
            "cudaAvailable": { "type": "boolean" },
            "deviceCount": { "type": "integer", "minimum": 0 },
            "deviceClass": { "type": ["string", "null"] }
          }
        }
      }
    },
    "privateBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "sizeBytes", "reference", "accessOwnerRole"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "reference": { "$ref": "#/$defs/nonEmpty" },
        "accessOwnerRole": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/generationRow" }
    },
    "privacy": { "$ref": "#/$defs/publicPrivacy" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "artifactClass", "artifactId", "immutableRevision", "baseModelId", "baseRevision", "fileManifestSha256"],
      "properties": {
        "slot": { "enum": ["base", "v03", "v04", "v05-seed-a", "v05-seed-b", "v05", "tuned-mobile"] },
        "artifactClass": { "enum": ["base-runtime", "adapter", "tuned-mobile-artifact"] },
        "artifactId": { "$ref": "#/$defs/nonEmpty" },
        "immutableRevision": { "$ref": "#/$defs/revision" },
        "baseModelId": { "$ref": "#/$defs/nonEmpty" },
        "baseRevision": { "$ref": "#/$defs/revision" },
        "fileManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSequenceLength", "maxNewTokens", "doSample", "temperature", "topP", "topK", "seed"],
      "properties": {
        "maxSequenceLength": { "type": "integer", "minimum": 1 },
        "maxNewTokens": { "type": "integer", "minimum": 1 },
        "doSample": { "type": "boolean" },
        "temperature": { "type": ["number", "null"], "minimum": 0 },
        "topP": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "topK": { "type": ["integer", "null"], "minimum": 0 },
        "seed": { "type": "integer" }
      }
    },
    "generationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptId", "language", "category", "state", "inputTokens", "outputTokens", "hitTokenCap", "stopReason", "latencyMs", "errorCode"],
      "properties": {
        "promptId": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "language": { "enum": ["en", "sw"] },
        "category": { "$ref": "#/$defs/nonEmpty" },
        "state": { "enum": ["complete", "truncated", "error"] },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "hitTokenCap": { "type": "boolean" },
        "stopReason": { "enum": ["eos", "stop-sequence", "token-cap", "error"] },
        "latencyMs": { "type": "integer", "minimum": 0 },
        "errorCode": { "type": ["string", "null"], "pattern": "^[A-Z0-9_-]{1,64}$" }
      }
    },
    "publicPrivacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsRawPrompts", "containsRawCompletions", "containsSurvivorData", "containsExactLocations", "publicSafe"],
      "properties": {
        "containsRawPrompts": { "const": false },
        "containsRawCompletions": { "const": false },
        "containsSurvivorData": { "const": false },
        "containsExactLocations": { "const": false },
        "publicSafe": { "const": true }
      }
    }
  }
}
