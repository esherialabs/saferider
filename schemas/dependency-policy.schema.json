{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/dependency-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "policyId", "lockfiles", "allowedRegistryOrigins", "forbiddenDependencyProtocols", "ciAuditLevel", "releaseAuditMaximum", "releaseAuditMaxAgeHours", "unknownLicenseInventory", "reviewedLicenseInventory", "unknownLicensesRequireLegalReview"],
  "properties": {
    "schema": { "const": "schemas/dependency-policy.schema.json" },
    "schemaVersion": { "const": 1 },
    "policyId": { "const": "saferide-dependency-policy-v1" },
    "lockfiles": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspace", "path"],
        "properties": {
          "workspace": { "enum": ["mobile", "api", "web"] },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allowedRegistryOrigins": { "const": ["https://registry.npmjs.org"] },
    "forbiddenDependencyProtocols": {
      "type": "array",
      "contains": { "const": "http:" },
      "items": { "type": "string", "minLength": 1 }
    },
    "ciAuditLevel": { "const": "high" },
    "releaseAuditMaximum": { "const": "none" },
    "releaseAuditMaxAgeHours": { "type": "integer", "minimum": 1, "maximum": 24 },
    "unknownLicenseInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspace", "packagePath", "name", "version"],
        "properties": {
          "workspace": { "enum": ["mobile", "api", "web"] },
          "packagePath": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewedLicenseInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspace", "packagePath", "name", "version", "licenseExpression", "evidencePath", "evidenceSha256"],
        "properties": {
          "workspace": { "enum": ["mobile", "api", "web"] },
          "packagePath": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "licenseExpression": { "type": "string", "minLength": 1 },
          "evidencePath": { "type": "string", "minLength": 1 },
          "evidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "unknownLicensesRequireLegalReview": { "const": true }
  }
}
