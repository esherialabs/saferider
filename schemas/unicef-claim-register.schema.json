{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/unicef-claim-register.schema.json",
  "title": "SafeRide UNICEF claim register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "registerId", "asOfDate", "claims"],
  "properties": {
    "schema": { "const": "com.saferide.unicef-claim-register" },
    "schemaVersion": { "const": 1 },
    "registerId": { "$ref": "#/$defs/nonEmpty" },
    "asOfDate": { "$ref": "#/$defs/date" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "approvedWording",
          "workplanRefs",
          "status",
          "evidenceRefs",
          "ownerRole",
          "reviewerRoles",
          "lastVerifiedDate",
          "recheckDate",
          "limitation",
          "blocker",
          "classification"
        ],
        "properties": {
          "claimId": { "$ref": "#/$defs/nonEmpty" },
          "approvedWording": { "$ref": "#/$defs/nonEmpty" },
          "workplanRefs": { "$ref": "#/$defs/nonEmptyArray" },
          "status": {
            "enum": [
              "not-started",
              "implementation-in-progress",
              "implemented-unverified",
              "verified-internal",
              "checkpoint-candidate",
              "blocked",
              "withdrawn"
            ]
          },
          "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
          "ownerRole": { "$ref": "#/$defs/nonEmpty" },
          "reviewerRoles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
          "lastVerifiedDate": { "$ref": "#/$defs/date" },
          "recheckDate": { "$ref": "#/$defs/date" },
          "limitation": { "$ref": "#/$defs/nonEmpty" },
          "blocker": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
          "classification": { "enum": ["public", "internal", "restricted"] }
        }
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
