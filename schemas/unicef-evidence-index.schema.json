{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/unicef-evidence-index.schema.json",
  "title": "SafeRide UNICEF checkpoint evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "indexId", "asOfDate", "evidence"],
  "properties": {
    "schema": { "const": "com.saferide.unicef-evidence-index" },
    "schemaVersion": { "const": 1 },
    "indexId": { "$ref": "#/$defs/nonEmpty" },
    "asOfDate": { "$ref": "#/$defs/date" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceId",
          "title",
          "workplanRefs",
          "sourceType",
          "contentClass",
          "repositoryPath",
          "externalReference",
          "commitOrRevision",
          "sha256",
          "sensitivity",
          "ownerRole",
          "reviewerRole",
          "evidenceDate",
          "reviewDate",
          "recheckDate",
          "status",
          "limitations",
          "accessInstructions",
          "assertions"
        ],
        "properties": {
          "evidenceId": { "$ref": "#/$defs/nonEmpty" },
          "title": { "$ref": "#/$defs/nonEmpty" },
          "workplanRefs": { "$ref": "#/$defs/nonEmptyArray" },
          "sourceType": { "enum": ["repository-file", "external-artifact", "human-review", "device-run", "colab-run", "program-record"] },
          "contentClass": {
            "enum": [
              "aggregate-summary",
              "manifest",
              "source-code",
              "test-report",
              "decision-record",
              "raw-prompt",
              "raw-completion",
              "raw-transcript",
              "survivor-record",
              "exact-location",
              "credential",
              "partner-confidential"
            ]
          },
          "repositoryPath": { "oneOf": [{ "$ref": "#/$defs/repoPath" }, { "type": "null" }] },
          "externalReference": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
          "commitOrRevision": { "$ref": "#/$defs/nonEmpty" },
          "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "sensitivity": { "enum": ["public", "internal", "restricted"] },
          "ownerRole": { "$ref": "#/$defs/nonEmpty" },
          "reviewerRole": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
          "evidenceDate": { "$ref": "#/$defs/date" },
          "reviewDate": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
          "recheckDate": { "$ref": "#/$defs/date" },
          "status": { "enum": ["draft", "review-pending", "verified", "blocked", "superseded"] },
          "limitations": { "$ref": "#/$defs/nonEmptyArray" },
          "accessInstructions": { "$ref": "#/$defs/nonEmpty" },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subject", "predicate", "value"],
              "properties": {
                "subject": { "$ref": "#/$defs/nonEmpty" },
                "predicate": { "$ref": "#/$defs/nonEmpty" },
                "value": { "$ref": "#/$defs/nonEmpty" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "sourceType": { "const": "repository-file" } }, "required": ["sourceType"] },
            "then": {
              "properties": {
                "repositoryPath": { "$ref": "#/$defs/repoPath" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          },
          {
            "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
            "then": {
              "properties": {
                "reviewerRole": { "$ref": "#/$defs/nonEmpty" },
                "reviewDate": { "$ref": "#/$defs/date" }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$" }
  }
}
