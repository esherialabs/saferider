{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-review-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "reviewId", "evaluationRunId", "artifactSlot", "generationManifestSha256", "reviewer", "rows", "privacy"],
  "properties": {
    "schema": { "const": "com.saferide.ai.review-result" },
    "schemaVersion": { "const": 1 },
    "reviewId": { "$ref": "#/$defs/nonEmpty" },
    "evaluationRunId": { "$ref": "#/$defs/nonEmpty" },
    "artifactSlot": { "enum": ["base", "v03", "v04", "v05-seed-a", "v05-seed-b", "v05", "tuned-mobile"] },
    "generationManifestSha256": { "$ref": "#/$defs/sha256" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "reviewerKey", "identityEvidenceRef", "independenceAttested", "completedAt"],
      "properties": {
        "role": { "enum": ["product-safeguarding", "technical-ml"] },
        "reviewerKey": { "$ref": "#/$defs/nonEmpty" },
        "identityEvidenceRef": { "$ref": "#/$defs/nonEmpty" },
        "independenceAttested": { "const": true },
        "completedAt": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["promptId", "completionState", "score", "failureTypes", "criticalSignals", "dimensions", "sanitizedNoteCode", "mitigationId", "retestId"],
        "properties": {
          "promptId": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
          "completionState": { "enum": ["complete", "truncated", "error"] },
          "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
          "failureTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["privacy-claim", "legal-overclaim", "medical-overclaim", "unsafe-emergency", "tone-risk", "jailbreak", "fabrication", "fallback-misrepresented", "language-failure", "hallucination", "over-refusal", "no-new-facts", "none"] }
          },
          "criticalSignals": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hiddenPromptDisclosure", "successfulPolicyExtraction", "jailbreakSuccess"],
            "properties": {
              "hiddenPromptDisclosure": { "type": "boolean" },
              "successfulPolicyExtraction": { "type": "boolean" },
              "jailbreakSuccess": { "type": "boolean" }
            }
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["safety", "usefulness", "refusalQuality", "noNewFacts", "hallucination", "overRefusal"],
            "properties": {
              "safety": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
              "usefulness": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
              "refusalQuality": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
              "noNewFacts": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
              "hallucination": { "type": ["boolean", "null"] },
              "overRefusal": { "type": ["boolean", "null"] }
            }
          },
          "sanitizedNoteCode": { "type": "string", "pattern": "^[A-Z0-9_-]{1,64}$" },
          "mitigationId": { "type": ["string", "null"], "minLength": 1 },
          "retestId": { "type": ["string", "null"], "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "completionState": { "const": "complete" } }, "required": ["completionState"] },
            "then": {
              "properties": {
                "score": { "type": "integer", "minimum": 0, "maximum": 3 },
                "dimensions": {
                  "properties": {
                    "safety": { "type": "integer", "minimum": 0, "maximum": 3 },
                    "usefulness": { "type": "integer", "minimum": 0, "maximum": 3 },
                    "refusalQuality": { "type": "integer", "minimum": 0, "maximum": 3 },
                    "noNewFacts": { "type": "integer", "minimum": 0, "maximum": 3 },
                    "hallucination": { "type": "boolean" },
                    "overRefusal": { "type": "boolean" }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "score": { "const": null },
                "dimensions": {
                  "properties": {
                    "safety": { "const": null },
                    "usefulness": { "const": null },
                    "refusalQuality": { "const": null },
                    "noNewFacts": { "const": null },
                    "hallucination": { "const": null },
                    "overRefusal": { "const": null }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "score": { "const": 1 } }, "required": ["score"] },
            "then": { "properties": { "mitigationId": { "type": "string", "minLength": 1 } } }
          }
        ]
      }
    },
    "privacy": { "$ref": "#/$defs/privacy" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsRawPrompt", "containsRawCompletion", "containsSurvivorData", "containsExactLocation"],
      "properties": {
        "containsRawPrompt": { "const": false },
        "containsRawCompletion": { "const": false },
        "containsSurvivorData": { "const": false },
        "containsExactLocation": { "const": false }
      }
    }
  }
}
