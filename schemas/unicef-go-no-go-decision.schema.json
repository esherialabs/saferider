{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/unicef-go-no-go-decision.schema.json",
  "title": "SafeRide UNICEF go/no-go decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "decisionId", "asOfDate", "sourceRevision", "prd", "decision", "checkpointCandidate", "repositoryCoverage", "checkpointCriteria", "definitionOfDone", "blockingHandoffIds", "blockingClaimIds", "prohibitedClaims", "limitations", "rollbackTarget"],
  "properties": {
    "schema": { "const": "com.saferide.unicef-go-no-go-decision" },
    "schemaVersion": { "const": 1 },
    "decisionId": { "$ref": "#/$defs/nonEmpty" },
    "asOfDate": { "$ref": "#/$defs/date" },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "prd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "decision": { "enum": ["blocked", "checkpoint-candidate", "withdrawn"] },
    "checkpointCandidate": { "type": "boolean" },
    "repositoryCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableRequirementIdsMapped", "coverageUnitsMapped", "requiredMilestonesMapped", "requirementsIndependentlyVerified"],
      "properties": {
        "tableRequirementIdsMapped": { "type": "integer", "minimum": 0 },
        "coverageUnitsMapped": { "type": "integer", "minimum": 1 },
        "requiredMilestonesMapped": { "type": "integer", "minimum": 1 },
        "requirementsIndependentlyVerified": { "const": 0 }
      }
    },
    "checkpointCriteria": { "$ref": "#/$defs/decisionArray" },
    "definitionOfDone": { "$ref": "#/$defs/decisionArray" },
    "blockingHandoffIds": { "$ref": "#/$defs/nonEmptyArray" },
    "blockingClaimIds": { "$ref": "#/$defs/nonEmptyArray" },
    "prohibitedClaims": { "$ref": "#/$defs/nonEmptyArray" },
    "limitations": { "$ref": "#/$defs/nonEmptyArray" },
    "rollbackTarget": { "const": "fail-closed:no-unicef-release" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decisionArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "status", "blockers"],
        "properties": {
          "criterionId": { "$ref": "#/$defs/nonEmpty" },
          "status": { "enum": ["satisfied", "satisfied-disabled", "implemented-unverified", "blocked-external"] },
          "blockers": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
  }
}
