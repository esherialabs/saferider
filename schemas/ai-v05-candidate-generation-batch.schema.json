{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-v05-candidate-generation-batch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "batchId", "datasetId", "classification", "runId", "sourceCommit", "configurationSha256", "authoringPackSha256", "orderedJobIds", "candidateOrdinals", "startedAt", "completedAt", "counts", "retryCountsByReason", "candidateFile", "completedSlots", "failures", "privacy"],
  "properties": {
    "schema": { "const": "com.saferide.ai.v05-candidate-generation-batch" },
    "schemaVersion": { "const": 1 },
    "batchId": { "type": "string", "pattern": "^v05-generation-batch-[0-9]{4}-[a-f0-9]{8}$" },
    "datasetId": { "const": "saferide-synthetic-guidance-v0.5.0" },
    "classification": { "const": "controlled-content-free" },
    "runId": { "type": "string", "minLength": 8 },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "configurationSha256": { "$ref": "#/$defs/sha" },
    "authoringPackSha256": { "$ref": "#/$defs/sha" },
    "orderedJobIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
    "candidateOrdinals": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 3 } },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["requested", "completed", "deterministicRejected", "transportFailed"],
      "properties": {
        "requested": { "type": "integer", "minimum": 0 }, "completed": { "type": "integer", "minimum": 0 },
        "deterministicRejected": { "type": "integer", "minimum": 0 }, "transportFailed": { "type": "integer", "minimum": 0 }
      }
    },
    "retryCountsByReason": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "candidateFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes", "candidateCount"],
      "properties": {
        "path": { "type": "string", "pattern": "^candidates/incoming/[a-z0-9._-]+\\.jsonl$" },
        "sha256": { "$ref": "#/$defs/sha" }, "sizeBytes": { "type": "integer", "minimum": 1 },
        "candidateCount": { "type": "integer", "minimum": 0 }
      }
    },
    "completedSlots": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["jobId", "ordinal", "candidateId", "candidateContentSha256"],
        "properties": {
          "jobId": { "type": "string", "minLength": 8 }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 3 },
          "candidateId": { "type": "string", "minLength": 8 }, "candidateContentSha256": { "$ref": "#/$defs/sha" }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["jobId", "ordinal", "reasonCode", "attempts"],
        "properties": {
          "jobId": { "type": "string", "minLength": 8 }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 3 },
          "reasonCode": { "enum": ["TRANSIENT_TIMEOUT", "TRANSIENT_RATE_LIMIT", "PROVIDER_PROCESS_FAILED", "MALFORMED_PROVIDER_OUTPUT", "DETERMINISTIC_PROVIDER_REJECTION", "CANDIDATE_SCHEMA_REJECTION"] },
          "attempts": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["containsPrompts", "containsCompletions", "containsCredentials", "containsRequestResponseBodies"],
      "properties": {
        "containsPrompts": { "const": false }, "containsCompletions": { "const": false },
        "containsCredentials": { "const": false }, "containsRequestResponseBodies": { "const": false }
      }
    }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
