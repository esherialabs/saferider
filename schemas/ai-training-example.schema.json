{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-training-example.schema.json",
  "title": "SafeRide v0.5 candidate or final synthetic conversation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "stage", "id", "candidateId", "datasetId", "split", "messages", "metadata", "authoring"],
  "properties": {
    "schema": { "const": "com.saferide.ai.training-example" },
    "schemaVersion": { "const": 1 },
    "stage": { "enum": ["candidate", "final"] },
    "id": { "type": "string", "pattern": "^v05-(privacy|legal|medical|emergency|tone|coercion|fabrication|product|jailbreak|noNewFacts)-family-[0-9]{4}-(en|sw)$" },
    "candidateId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$" },
    "datasetId": { "const": "saferide-synthetic-guidance-v0.5.0" },
    "split": { "$ref": "#/$defs/split" },
    "messages": {
      "type": "array", "minItems": 2, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": [
        "language", "primaryCategory", "secondaryTags", "scenarioFamilyId",
        "semanticClusterId", "conversationForm", "riskLevel", "userGoalCode",
        "appState", "responseStrategy", "responseSkeletonId", "sourceKind",
        "sourcePolicyRefs", "generatorVersion", "reviewStatus",
        "prohibitedDataScreen", "longResponseReason"
      ],
      "properties": {
        "language": { "enum": ["en", "sw"] },
        "primaryCategory": { "$ref": "#/$defs/category" },
        "secondaryTags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/category" } },
        "scenarioFamilyId": { "type": "string", "pattern": "^v05-.+-family-[0-9]{4}$" },
        "semanticClusterId": { "type": "string", "pattern": "^v05-cluster-[a-z0-9][a-z0-9-]{2,95}$" },
        "conversationForm": { "enum": ["single-turn", "multi-turn"] },
        "riskLevel": { "enum": ["low", "medium", "high", "critical"] },
        "userGoalCode": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$" },
        "appState": { "type": "string", "minLength": 2, "maxLength": 64 },
        "responseStrategy": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$" },
        "responseSkeletonId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,127}$" },
        "sourceKind": { "const": "repository-authored-synthetic" },
        "sourcePolicyRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^POLICY-[A-Z0-9-]{2,80}$" } },
        "generatorVersion": { "type": "string", "minLength": 3, "maxLength": 128 },
        "reviewLedgerRefs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "reviewableContentSha256": { "$ref": "#/$defs/sha256" },
        "systemPromptSha256": { "$ref": "#/$defs/sha256" },
        "reviewStatus": { "$ref": "#/$defs/reviewStatus" },
        "prohibitedDataScreen": { "enum": ["pending", "passed", "failed"] },
        "longResponseReason": { "type": ["string", "null"], "minLength": 3, "maxLength": 240 }
      }
    },
    "authoring": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "toolId", "toolRevision", "configurationSha256", "authoringPromptSha256", "scenarioFamilyId", "createdAt", "authorIdentityRef", "termsAssessmentRef", "syntheticOnlyAttested", "status"],
      "properties": {
        "method": { "enum": ["human", "approved-model-assisted", "hybrid", "deterministic-mock"] },
        "toolId": { "type": "string", "minLength": 2, "maxLength": 160 },
        "toolRevision": { "type": "string", "minLength": 2, "maxLength": 160 },
        "configurationSha256": { "$ref": "#/$defs/sha256" },
        "authoringPromptSha256": { "$ref": "#/$defs/sha256" },
        "scenarioFamilyId": { "type": "string", "pattern": "^v05-.+-family-[0-9]{4}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "authorIdentityRef": { "type": "string", "minLength": 3, "maxLength": 160 },
        "termsAssessmentRef": { "type": "string", "minLength": 3, "maxLength": 240 },
        "syntheticOnlyAttested": { "const": true },
        "status": { "enum": ["unreviewed", "selected", "rejected"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "candidate" } }, "required": ["stage"] },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "reviewStatus": { "const": "unreviewed" },
              "prohibitedDataScreen": { "enum": ["pending", "passed"] }
            }
          },
          "authoring": { "properties": { "status": { "const": "unreviewed" } } }
        }
      },
      "else": {
        "properties": {
          "metadata": {
            "required": ["reviewLedgerRefs", "reviewableContentSha256", "systemPromptSha256"],
            "properties": {
              "reviewStatus": { "enum": ["approved-train", "approved-dev", "approved-quality-holdout", "approved-safety-holdout"] },
              "prohibitedDataScreen": { "const": "passed" }
            }
          },
          "authoring": { "properties": { "status": { "const": "selected" } } }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "category": { "enum": ["privacy", "legal", "medical", "emergency", "tone", "coercion", "fabrication", "product", "jailbreak", "noNewFacts"] },
    "split": { "enum": ["train", "dev", "quality-holdout", "safety-holdout"] },
    "reviewStatus": { "enum": ["unreviewed", "approved-train", "approved-dev", "approved-quality-holdout", "approved-safety-holdout", "needs-revision", "rejected", "never-train"] }
  }
}
