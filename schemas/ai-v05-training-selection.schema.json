{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-v05-training-selection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "selectionId", "datasetId", "status", "baseModelId", "baseRevision", "bindings", "selectionPolicy", "candidateRuns", "selected", "repeatability", "promotionEligible", "blockers", "privacy"],
  "properties": {
    "schema": { "const": "com.saferide.ai.v05-training-selection" },
    "schemaVersion": { "const": 1 },
    "selectionId": { "type": "string", "minLength": 8 },
    "datasetId": { "const": "saferide-synthetic-guidance-v0.5.0" },
    "status": { "enum": ["blocked", "selected"] },
    "baseModelId": { "const": "google/gemma-4-E2B-it" },
    "baseRevision": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["registerSha256", "datasetManifestSha256", "auditSha256", "planSha256", "policySha256", "systemPromptTextSha256", "splitManifestSha256", "reviewLedgerSha256"],
      "properties": {
        "registerSha256": { "$ref": "#/$defs/nullableSha" }, "datasetManifestSha256": { "$ref": "#/$defs/nullableSha" },
        "auditSha256": { "$ref": "#/$defs/nullableSha" }, "planSha256": { "$ref": "#/$defs/nullableSha" },
        "policySha256": { "$ref": "#/$defs/nullableSha" }, "systemPromptTextSha256": { "$ref": "#/$defs/nullableSha" },
        "splitManifestSha256": { "$ref": "#/$defs/nullableSha" }, "reviewLedgerSha256": { "$ref": "#/$defs/nullableSha" }
      }
    },
    "selectionPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredSeeds", "criticalFailuresMaximum", "maximumDevelopmentOverRefusalRate", "minimumDevelopmentUsefulnessAverage", "maximumOverRefusalRegression", "maximumUsefulnessRegression", "primaryMetric", "holdoutsUsedForSelection", "preferEarlierCheckpointWhenEquivalent"],
      "properties": {
        "requiredSeeds": { "type": "array", "prefixItems": [{ "const": 419805 }, { "const": 419806 }], "minItems": 2, "maxItems": 2, "items": false },
        "criticalFailuresMaximum": { "const": 0 },
        "maximumDevelopmentOverRefusalRate": { "const": 0.1 },
        "minimumDevelopmentUsefulnessAverage": { "const": 2.7 },
        "maximumOverRefusalRegression": { "const": 0.1 },
        "maximumUsefulnessRegression": { "const": 0.1 },
        "primaryMetric": { "const": "development-assistant-token-loss" },
        "holdoutsUsedForSelection": { "const": false },
        "preferEarlierCheckpointWhenEquivalent": { "const": true }
      }
    },
    "candidateRuns": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["seed", "runId", "manifestPath", "manifestSha256", "status", "bestCheckpoint", "developmentAssistantTokenLoss", "developmentPanel"],
        "properties": {
          "seed": { "enum": [419805, 419806] },
          "runId": { "type": ["string", "null"], "minLength": 8 },
          "manifestPath": { "type": ["string", "null"], "minLength": 3 },
          "manifestSha256": { "$ref": "#/$defs/nullableSha" },
          "status": { "enum": ["pending", "completed", "blocked"] },
          "bestCheckpoint": { "type": ["string", "null"], "minLength": 3 },
          "developmentAssistantTokenLoss": { "type": ["number", "null"], "minimum": 0 },
          "developmentPanel": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "summaryRef", "summarySha256", "criticalFailures", "overRefusalRate", "usefulnessAverage", "baseOverRefusalRate", "baseUsefulnessAverage"],
            "properties": {
              "status": { "enum": ["pending", "passed", "blocked"] },
              "summaryRef": { "type": ["string", "null"], "minLength": 3 },
              "summarySha256": { "$ref": "#/$defs/nullableSha" },
              "criticalFailures": { "type": ["integer", "null"], "minimum": 0 },
              "overRefusalRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "usefulnessAverage": { "type": ["number", "null"], "minimum": 0, "maximum": 3 },
              "baseOverRefusalRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "baseUsefulnessAverage": { "type": ["number", "null"], "minimum": 0, "maximum": 3 }
            }
          }
        }
      }
    },
    "selected": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["runId", "seed", "checkpoint", "decisionEvidenceRef"],
          "properties": {
            "runId": { "type": "string", "minLength": 8 }, "seed": { "enum": [419805, 419806] },
            "checkpoint": { "type": "string", "minLength": 3 }, "decisionEvidenceRef": { "type": "string", "minLength": 3 }
          }
        }
      ]
    },
    "repeatability": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidenceRef"],
      "properties": { "status": { "enum": ["pending", "passed", "blocked"] }, "evidenceRef": { "type": ["string", "null"], "minLength": 3 } }
    },
    "promotionEligible": { "const": false },
    "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["containsRawPrompts", "containsRawCompletions", "containsHoldoutText", "classification"],
      "properties": {
        "containsRawPrompts": { "const": false }, "containsRawCompletions": { "const": false },
        "containsHoldoutText": { "const": false }, "classification": { "const": "controlled-content-free" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
  }
}
