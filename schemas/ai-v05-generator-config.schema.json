{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-v05-generator-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "configId", "datasetId", "status", "runId", "runCreatedAt", "sourceCommit", "bindings", "provider", "model", "generation", "authoring", "scope", "approval", "privacy"],
  "properties": {
    "schema": { "const": "com.saferide.ai.v05-generator-config" },
    "schemaVersion": { "const": 1 },
    "configId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$" },
    "datasetId": { "const": "saferide-synthetic-guidance-v0.5.0" },
    "status": { "enum": ["test-only", "approved-controlled"] },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$" },
    "runCreatedAt": { "type": "string", "format": "date-time" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["authoringPackSha256", "scenarioMatrixSha256", "splitManifestSha256"],
      "properties": {
        "authoringPackSha256": { "$ref": "#/$defs/sha" },
        "scenarioMatrixSha256": { "$ref": "#/$defs/sha" },
        "splitManifestSha256": { "$ref": "#/$defs/sha" }
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "providerId", "immutableRevision", "remote", "timeoutMs", "executablePath", "executableSha256", "arguments", "credentialEnvironmentVariable", "allowedEnvironmentVariables"],
      "properties": {
        "protocol": { "enum": ["mock-v1", "stdio-json-v1"] },
        "providerId": { "type": "string", "minLength": 3, "maxLength": 160 },
        "immutableRevision": { "type": "string", "minLength": 3, "maxLength": 160 },
        "remote": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "executablePath": { "type": ["string", "null"], "minLength": 1 },
        "executableSha256": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "arguments": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 200 } },
        "credentialEnvironmentVariable": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,80}$" },
        "allowedEnvironmentVariables": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,80}$" } }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["modelId", "immutableRevision"],
      "properties": {
        "modelId": { "type": "string", "minLength": 3, "maxLength": 200 },
        "immutableRevision": { "type": "string", "minLength": 3, "maxLength": 160 }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateOrdinals", "batchSize", "maximumRetries", "maxOutputTokens", "temperature", "topP"],
      "properties": {
        "candidateOrdinals": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 3 } },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maximumRetries": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "topP": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "authoring": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "toolId", "toolRevision", "authoringPromptId", "authoringPromptSha256", "policySha256", "systemPromptConfigSha256", "authorIdentityRef", "termsAssessmentRef", "languageMode", "systemMessageInCandidate", "syntheticOnlyAttested"],
      "properties": {
        "method": { "enum": ["approved-model-assisted", "deterministic-mock"] },
        "toolId": { "type": "string", "minLength": 2, "maxLength": 160 },
        "toolRevision": { "type": "string", "minLength": 2, "maxLength": 160 },
        "authoringPromptId": { "type": "string", "minLength": 3, "maxLength": 160 },
        "authoringPromptSha256": { "$ref": "#/$defs/sha" },
        "policySha256": { "$ref": "#/$defs/sha" },
        "systemPromptConfigSha256": { "$ref": "#/$defs/sha" },
        "authorIdentityRef": { "type": "string", "minLength": 3, "maxLength": 160 },
        "termsAssessmentRef": { "type": "string", "minLength": 3, "maxLength": 240 },
        "languageMode": { "const": "independent-from-shared-scenario" },
        "systemMessageInCandidate": { "const": false },
        "syntheticOnlyAttested": { "const": true }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "jobIds"],
      "properties": {
        "mode": { "enum": ["all", "explicit"] },
        "jobIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^author:v05-.+-(en|sw)$" } }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["remoteGenerationApproved", "configurationOwnerRef", "approvalEvidenceRef"],
      "properties": {
        "remoteGenerationApproved": { "type": "boolean" },
        "configurationOwnerRef": { "type": ["string", "null"], "minLength": 3 },
        "approvalEvidenceRef": { "type": ["string", "null"], "minLength": 3 }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceBoundary", "rawContentLoggingAllowed", "requestResponseLoggingAllowed", "holdoutsAllowed", "blindPromptsAllowed", "survivorDataAllowed", "productionLogsAllowed"],
      "properties": {
        "sourceBoundary": { "const": "synthetic-only" },
        "rawContentLoggingAllowed": { "const": false },
        "requestResponseLoggingAllowed": { "const": false },
        "holdoutsAllowed": { "const": false },
        "blindPromptsAllowed": { "const": false },
        "survivorDataAllowed": { "const": false },
        "productionLogsAllowed": { "const": false }
      }
    },
    "mock": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "failurePlan"],
      "properties": {
        "seed": { "type": "integer" },
        "failurePlan": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["jobId", "ordinal", "outcomes"],
            "properties": {
              "jobId": { "type": "string", "minLength": 8 },
              "ordinal": { "type": "integer", "minimum": 1, "maximum": 3 },
              "outcomes": { "type": "array", "minItems": 1, "items": { "enum": ["success", "transient-timeout", "transient-rate-limit", "malformed-output", "deterministic-rejection"] } }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "test-only" } }, "required": ["status"] },
      "then": {
        "required": ["mock"],
        "properties": {
          "provider": { "properties": { "protocol": { "const": "mock-v1" }, "remote": { "const": false }, "executablePath": { "type": "null" }, "executableSha256": { "type": "null" }, "credentialEnvironmentVariable": { "type": "null" } } },
          "authoring": { "properties": { "method": { "const": "deterministic-mock" } } },
          "approval": { "properties": { "remoteGenerationApproved": { "const": false }, "configurationOwnerRef": { "type": "null" }, "approvalEvidenceRef": { "type": "null" } } }
        }
      },
      "else": {
        "properties": {
          "provider": { "properties": { "protocol": { "const": "stdio-json-v1" }, "executablePath": { "type": "string" }, "executableSha256": { "$ref": "#/$defs/sha" } } },
          "authoring": { "properties": { "method": { "const": "approved-model-assisted" } } },
          "approval": { "properties": { "configurationOwnerRef": { "type": "string" }, "approvalEvidenceRef": { "type": "string" } } }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "properties": { "remote": { "const": true } }, "required": ["remote"] } } },
      "then": { "properties": { "approval": { "properties": { "remoteGenerationApproved": { "const": true } } } } }
    },
    {
      "if": { "properties": { "scope": { "properties": { "mode": { "const": "all" } }, "required": ["mode"] } } },
      "then": { "properties": { "scope": { "properties": { "jobIds": { "maxItems": 0 } } } } },
      "else": { "properties": { "scope": { "properties": { "jobIds": { "minItems": 1 } } } } }
    }
  ],
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
