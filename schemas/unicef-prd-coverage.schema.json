{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/unicef-prd-coverage.schema.json",
  "title": "SafeRide UNICEF PRD coverage and go/no-go contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "coverageId", "asOfDate", "sourceRevision", "prd", "decision", "requiredMilestones", "coverageUnits", "controlAssertions", "checkpointCriteria", "definitionOfDone", "copyPolicy"],
  "properties": {
    "schema": { "const": "com.saferide.unicef-prd-coverage" },
    "schemaVersion": { "const": 1 },
    "coverageId": { "$ref": "#/$defs/nonEmpty" },
    "asOfDate": { "$ref": "#/$defs/date" },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "prd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "expectedTableRequirementCount"],
      "properties": {
        "path": { "const": "docs/product/saferide-unicef-full-implementation-technical-prd-2026-07-30.md" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "expectedTableRequirementCount": { "type": "integer", "minimum": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "checkpointCandidate", "rollbackTarget"],
      "properties": {
        "state": { "enum": ["blocked", "checkpoint-candidate", "withdrawn"] },
        "checkpointCandidate": { "type": "boolean" },
        "rollbackTarget": { "const": "fail-closed:no-unicef-release" }
      }
    },
    "requiredMilestones": { "$ref": "#/$defs/nonEmptyArray" },
    "coverageUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "title", "milestoneRefs", "requirementIds", "repositoryStatus", "promotionStatus", "requiredPaths", "validatorCommands", "claimIds", "evidenceIds", "handoffIds", "limitations", "rollback"],
        "properties": {
          "unitId": { "$ref": "#/$defs/nonEmpty" },
          "title": { "$ref": "#/$defs/nonEmpty" },
          "milestoneRefs": { "$ref": "#/$defs/nonEmptyArray" },
          "requirementIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" } },
          "repositoryStatus": { "const": "mapped-unverified" },
          "promotionStatus": { "enum": ["implemented-unverified", "blocked-external", "satisfied-disabled"] },
          "requiredPaths": { "$ref": "#/$defs/nonEmptyArray" },
          "validatorCommands": { "$ref": "#/$defs/nonEmptyArray" },
          "claimIds": { "$ref": "#/$defs/nonEmptyArray" },
          "evidenceIds": { "$ref": "#/$defs/nonEmptyArray" },
          "handoffIds": { "$ref": "#/$defs/nonEmptyArray" },
          "limitations": { "$ref": "#/$defs/nonEmptyArray" },
          "rollback": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "controlAssertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlId", "path", "pointer", "expected"],
        "properties": {
          "controlId": { "$ref": "#/$defs/nonEmpty" },
          "path": { "$ref": "#/$defs/repoPath" },
          "pointer": { "type": "string", "pattern": "^/" },
          "expected": {}
        }
      }
    },
    "checkpointCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "definitionOfDone": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "copyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedProgressClaimId", "prohibitedClaims"],
      "properties": {
        "allowedProgressClaimId": { "const": "UNICEF-CHECKPOINT-001" },
        "prohibitedClaims": { "$ref": "#/$defs/nonEmptyArray" }
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "title", "requiredForCandidate", "status", "claimIds", "evidenceIds", "handoffIds", "blockers"],
      "properties": {
        "criterionId": { "$ref": "#/$defs/nonEmpty" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "requiredForCandidate": { "const": true },
        "status": { "enum": ["satisfied", "satisfied-disabled", "implemented-unverified", "blocked-external"] },
        "claimIds": { "$ref": "#/$defs/nonEmptyArray" },
        "evidenceIds": { "$ref": "#/$defs/nonEmptyArray" },
        "handoffIds": { "$ref": "#/$defs/stringArray" },
        "blockers": { "$ref": "#/$defs/stringArray" }
      }
    },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
  }
}
