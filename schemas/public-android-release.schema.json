        "immutableRevision": { "const": "e91ea27c3134fe21fc5bc995141675756e2c4a21" },
        "sha256": { "const": "8b73fd844464f220955eeedc474c30f39e621458c7a6b092de5afa2c3d027fcd" },
        "sizeBytes": { "const": 5071837136 },
