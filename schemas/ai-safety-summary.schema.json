{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-safety-summary.schema.json",
  "title": "SafeRide public-safe AI safety summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "summaryId",
    "artifactClass",
    "artifactId",
    "evaluationRunId",
    "promptSuiteId",
    "rubricId",
    "policyId",
    "counts",
    "scores",
    "review",
    "languageSlices",
    "privacy",
    "decision",
    "blockers",
    "evidenceRefs",
    "lastVerifiedDate",
    "recheckDate"
  ],
  "properties": {
    "schema": { "const": "com.saferide.ai-safety-summary" },
    "schemaVersion": { "const": 1 },
    "summaryId": { "$ref": "#/$defs/nonEmpty" },
    "artifactClass": { "enum": ["base-runtime", "adapter", "tuned-mobile-artifact"] },
    "artifactId": { "$ref": "#/$defs/nonEmpty" },
    "evaluationRunId": { "$ref": "#/$defs/nonEmpty" },
    "promptSuiteId": { "$ref": "#/$defs/nonEmpty" },
    "rubricId": { "$ref": "#/$defs/nonEmpty" },
    "policyId": { "$ref": "#/$defs/nonEmpty" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredPrompts",
        "generatedResponses",
        "historicallyScoredResponses",
        "completedResponses",
        "validReviewedResponses",
        "truncatedResponses",
        "criticalFailures",
        "riskyResponses",
        "unresolvedScoreOneFindings"
      ],
      "properties": {
        "requiredPrompts": { "$ref": "#/$defs/count" },
        "generatedResponses": { "$ref": "#/$defs/count" },
        "historicallyScoredResponses": { "$ref": "#/$defs/count" },
        "completedResponses": { "$ref": "#/$defs/count" },
        "validReviewedResponses": { "$ref": "#/$defs/count" },
        "truncatedResponses": { "$ref": "#/$defs/count" },
        "criticalFailures": { "$ref": "#/$defs/count" },
        "riskyResponses": { "$ref": "#/$defs/count" },
        "unresolvedScoreOneFindings": { "$ref": "#/$defs/count" }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historicalOverallAverage", "promotionAverage"],
      "properties": {
        "historicalOverallAverage": { "type": "number", "minimum": 0, "maximum": 3 },
        "promotionAverage": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 3 }, { "type": "null" }] }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independentReviewerCount", "requiredReviewerRoles", "completedReviewerRoles", "adjudicationStatus", "hiddenPromptDisclosureDetected"],
      "properties": {
        "independentReviewerCount": { "$ref": "#/$defs/count" },
        "requiredReviewerRoles": { "$ref": "#/$defs/nonEmptyArray" },
        "completedReviewerRoles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "adjudicationStatus": { "enum": ["not-required", "pending", "complete"] },
        "hiddenPromptDisclosureDetected": { "type": "boolean" }
      }
    },
    "languageSlices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "status", "reviewStatus"],
        "properties": {
          "locale": { "$ref": "#/$defs/nonEmpty" },
          "status": { "enum": ["evaluated", "not-evaluated", "disabled"] },
          "reviewStatus": { "enum": ["not-required", "pending", "approved", "blocked"] }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsRawPrompts", "containsRawCompletions", "containsSurvivorData", "containsExactLocations", "classification"],
      "properties": {
        "containsRawPrompts": { "const": false },
        "containsRawCompletions": { "const": false },
        "containsSurvivorData": { "const": false },
        "containsExactLocations": { "const": false },
        "classification": { "const": "public-safe-aggregate" }
      }
    },
    "decision": { "enum": ["blocked", "internal-only", "checkpoint-candidate", "release-candidate"] },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
    "evidenceRefs": { "$ref": "#/$defs/nonEmptyArray" },
    "lastVerifiedDate": { "$ref": "#/$defs/date" },
    "recheckDate": { "$ref": "#/$defs/date" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "count": { "type": "integer", "minimum": 0 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
