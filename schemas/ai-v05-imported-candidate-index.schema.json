{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-v05-imported-candidate-index.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schemaVersion", "datasetId", "classification", "bindings", "candidateCount", "representedSlotCount", "duplicateCandidateIdCount", "slotsOverMaximum", "candidateInventorySha256", "candidates", "privacy"],
  "properties": {
    "schema": { "const": "com.saferide.ai.v05-imported-candidate-index" }, "schemaVersion": { "const": 1 },
    "datasetId": { "const": "saferide-synthetic-guidance-v0.5.0" }, "classification": { "const": "controlled-content-free-identifiers" },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["scenarioMatrixSha256", "splitManifestSha256", "candidateFiles", "candidateFilesInventorySha256"],
      "properties": {
        "scenarioMatrixSha256": { "$ref": "#/$defs/sha" }, "splitManifestSha256": { "$ref": "#/$defs/sha" },
        "candidateFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "candidateFilesInventorySha256": { "$ref": "#/$defs/sha" }
      }
    },
    "candidateCount": { "type": "integer", "minimum": 0, "maximum": 7800 }, "representedSlotCount": { "type": "integer", "minimum": 0, "maximum": 2600 },
    "duplicateCandidateIdCount": { "type": "integer", "minimum": 0 }, "slotsOverMaximum": { "type": "integer", "minimum": 0 },
    "candidateInventorySha256": { "$ref": "#/$defs/sha" },
    "candidates": {
      "type": "array", "maxItems": 7800,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidateId", "rowId", "split", "candidateContentSha256", "sourceFileOrdinal", "sourceRecordOrdinal"],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1, "maxLength": 160 }, "rowId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "split": { "enum": ["train", "dev", "quality-holdout", "safety-holdout", "unknown"] }, "candidateContentSha256": { "$ref": "#/$defs/sha" },
          "sourceFileOrdinal": { "type": "integer", "minimum": 0 }, "sourceRecordOrdinal": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "privacy": { "type": "object", "additionalProperties": false, "required": ["containsRawText", "containsPrompts", "containsCompletions"], "properties": { "containsRawText": { "const": false }, "containsPrompts": { "const": false }, "containsCompletions": { "const": false } } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["sha256", "sizeBytes"], "properties": { "sha256": { "$ref": "#/$defs/sha" }, "sizeBytes": { "type": "integer", "minimum": 0 } } }
  }
}
