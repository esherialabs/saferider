# SafeRide local owned-infrastructure env template.
# Copy to infra/local/.env before running `npm run local:up`.
# These are local-only example values that pass the local validators.

LOCAL_POSTGRES_DB=saferide
LOCAL_POSTGRES_USER=saferide
LOCAL_POSTGRES_PASSWORD=local-example-postgres-password
LOCAL_POSTGRES_PORT=55432

LOCAL_REDIS_PORT=6379

LOCAL_MINIO_ROOT_USER=saferide-minio
LOCAL_MINIO_ROOT_PASSWORD=local-example-minio-root-password
LOCAL_MINIO_API_PORT=9000
LOCAL_MINIO_CONSOLE_PORT=9001
LOCAL_MINIO_BUCKET=evidence

LOCAL_AUTH_JWT_SECRET=local-example-auth-jwt-secret-32-byte-value

LOCAL_API_PORT=3333
LOCAL_WS_PORT=3334
LOCAL_API_LOG_LEVEL=info
LOCAL_API_CORS_ORIGINS=*

LOCAL_PROMETHEUS_PORT=9090
LOCAL_GRAFANA_PORT=3001
LOCAL_GRAFANA_ADMIN_USER=admin
LOCAL_GRAFANA_ADMIN_PASSWORD=local-example-grafana-password

# Use localhost for host-machine testing. For Expo Go on a physical phone,
# set this to your computer's LAN IP, for example 192.168.1.20.
LOCAL_PUBLIC_HOST=localhost
